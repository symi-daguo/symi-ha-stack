# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the blanks.
#   cp .env.example .env
#
# .env contains secrets (HA token). Keep it out of git — .gitignore already does.
# ─────────────────────────────────────────────────────────────────────────────

# Where the stack lives on disk. All bind mounts derive from this.
STACK_DIR=/opt/ha-stack

# Prefix for the container names. Leave empty for the default names
# (homeassistant, mosquitto, nodered, matter-hub). Set it to run a second
# copy of the stack on the same engine, e.g. CONTAINER_PREFIX=v- gives
# v-homeassistant, v-mosquitto, ...
CONTAINER_PREFIX=

# LAN interface used for Matter mDNS advertising.
# Find yours with:  ip route show default
# Examples: wlp0s20f3 (Wi-Fi), enp3s0 (Ethernet)
MDNS_INTERFACE=wlp0s20f3

# Timezone for all containers.
TZ=Asia/Shanghai

# ── Home Assistant ────────────────────────────────────────────────────────────
# Long-lived access token from HA:
#   HA UI → your profile → Security → Long-lived access tokens → Create token
# Create the token BEFORE first start (Matter Hub needs it).
HAMH_HA_TOKEN=REPLACE_WITH_YOUR_HA_TOKEN

# ── MQTT ──────────────────────────────────────────────────────────────────────
# Broker username. The password is stored in
#   $STACK_DIR/mosquitto/config/.ha_mqtt_password
# and is generated by scripts/setup-mqtt.sh.
MQTT_USER=ha_user

# ── Matter Hub ────────────────────────────────────────────────────────────────
# Upstream release. 1.7.x is the latest stable line.
# https://github.com/riddix/home-assistant-matter-hub/releases
MATTER_HUB_VERSION=1.7.18
MATTER_LOG_LEVEL=info

# Extra CLI flags for Matter Hub, space separated.
# --mdns-strip-global-ipv6 exists in upstream master but NOT in the
# published 1.x / 2.0.7 images — passing it there makes the container exit
# with "Unknown arguments". Enable it only when Apple Home shows devices as
# "No Response" and your LAN interface carries a global IPv6 address.
# See docs/TROUBLESHOOTING.md.
MATTER_HUB_EXTRA_ARGS=
